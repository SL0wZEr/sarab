# Generated by packaging/install.sh.
#
# A systemd *user* unit, never a system one: the runtime is your uid with no
# root anywhere, and freeze/thaw and memory accounting write into a cgroup
# under user@<uid>.service that you already own.
#
# Wanted by graphical-session.target: sarab-hostd's clipboard needs
# WAYLAND_DISPLAY and XDG_RUNTIME_DIR in the user manager's environment.
# Hyprland under uwsm puts them there; otherwise run
# `systemctl --user import-environment WAYLAND_DISPLAY` before enabling.
#
# Type=simple: `sarab start --foreground` neither forks nor sends sd_notify, so
# systemd calls the unit active about 1.5 s before Android has booted.
# `sarab status` says whether Android is up; `sarab start` without
# --foreground starts this unit and waits for exactly that.
#
# No WorkingDirectory or environment: sarab finds its directories from its own
# binary (`sarab info` lists them). The data directory is saved by `sarab
# setup`, but logs and icons follow XDG_STATE_HOME and XDG_DATA_HOME, so set
# those in ~/.config/environment.d, not only in a shell rc, or the unit and the
# shell use different ones. ExecStop uses --direct because plain
# `sarab stop` hands a unit-owned runtime to `systemctl --user stop`, which
# would be this line calling itself. Both quote sarab's path, so a prefix or
# home directory with a space in it stays one word.
#
# Restart=on-failure, never always: a runtime that returns after the user
# stopped it is a surprise. Exit status 4 means a runtime is already running,
# and 5 a host that cannot run it (not set up, no pasta, no GPU Android can
# use), which no retry can fix. A crash of sarab-hostd, which carries Android's
# display, stops Android and fails the start, so this brings both back, as it
# does when Android ends with an error after it booted. A restart from inside
# Android needs neither: `sarab start` boots it again itself, in the same
# process, and a power-off from inside ends the unit cleanly.
#
# No Delegate=, Slice= or cgroup limits: `sarab start` puts Android in a scope
# of its own (`systemd-run --user --scope`) whose cgroup is where
# cgroup.freeze and memory.reclaim are written. That scope sits under
# user.slice, not under this service, so limits belong on the scope.

[Unit]
Description=Android session runtime (sarab)
Documentation=file://@DOC@
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart="@SARAB@" start --foreground
ExecStop="@SARAB@" stop --direct
Restart=on-failure
RestartPreventExitStatus=4 5
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=graphical-session.target
